# --- MINT Protocol (required for attestation) ---
# Your MINT API key. Get one free at https://foundrynet.io/signup, or mint one
# programmatically with `mint_register` (see https://github.com/FoundryNet/mint-mcp).
MINT_API_KEY=fnet_your_key_here

# --- LLM provider (required to run the agents) ---
# CrewAI uses OpenAI by default; any LiteLLM-supported model works.
OPENAI_API_KEY=sk-your_openai_key_here
# Optional: pick a specific model
# MODEL=gpt-4o-mini
